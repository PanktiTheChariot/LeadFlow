# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/leadflow

# Secret used to sign session JWTs — generate with `openssl rand -base64 32`
JWT_SECRET=replace-with-a-long-random-string

# OpenAI API key for the "AI Generate Reply" feature.
# Optional: if unset, the app automatically falls back to a deterministic
# mock provider so the app remains fully runnable without a key.
OPENAI_API_KEY=

# Optional. If unset, GET /api/leads runs uncached (no behavior difference).
REDIS_URL=redis://localhost:6379

# Base URL of the app, used for cookie/OAuth configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Authorization Code + PKCE). Create credentials at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of `${NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback`
# (e.g. http://localhost:3000/api/auth/oauth/google/callback for local dev).
# Optional: if unset, the "Continue with Google" button redirects back to
# /login with an "isn't configured" error instead of failing at build time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
